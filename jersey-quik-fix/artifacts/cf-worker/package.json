{
  "name": "@workspace/cf-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "migrations:local": "wrangler d1 migrations apply jersey-quik-fix-d1 --local",
    "migrations:remote": "wrangler d1 migrations apply jersey-quik-fix-d1 --remote"
  },
  "dependencies": {
    "@clerk/backend": "^1.28.0",
    "hono": "^4.7.11",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.8.3",
    "wrangler": "^3.114.10"
  }
}
