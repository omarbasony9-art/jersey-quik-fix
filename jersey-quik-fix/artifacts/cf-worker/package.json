{
  "name": "@workspace/cf-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "verify:production-config": "node ../../scripts/verify-production-worker-config.mjs",
    "build": "pnpm run verify:production-config && wrangler deploy --dry-run --config wrangler.toml --outdir dist",
    "stage": "pnpm run verify:production-config && wrangler versions upload --config wrangler.toml --keep-vars",
    "migrations:local": "wrangler d1 migrations apply jersey-quik-fix-d1 --local",
    "migrations:remote": "wrangler d1 migrations apply jersey-quik-fix-d1 --remote"
  },
  "dependencies": {
    "@clerk/backend": "^1.28.0",
    "hono": "^4.7.11",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  }
}
